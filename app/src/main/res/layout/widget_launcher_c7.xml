<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <ImageView
        android:id="@+id/launcherPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/launcherBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/launcher_widget_bg_30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="24dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/launcherBarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/launcher_title"
                android:textColor="#8C97A8"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/launcherFav"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/launcher_tool_btn"
                android:contentDescription="@string/launcher_fav"
                android:padding="7dp"
                android:src="@drawable/ic_launcher_star" />

            <ImageView
                android:id="@+id/launcherSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/launcher_tool_btn"
                android:contentDescription="@string/launcher_search"
                android:padding="7dp"
                android:src="@drawable/ic_launcher_search" />

            <ImageView
                android:id="@+id/launcherSort"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/launcher_tool_btn"
                android:contentDescription="@string/launcher_sort"
                android:padding="7dp"
                android:src="@drawable/ic_launcher_sort" />

            <ImageView
                android:id="@+id/launcherConfig"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/launcher_tool_btn"
                android:contentDescription="@string/launcher_look"
                android:padding="7dp"
                android:src="@drawable/ic_launcher_gear" />
        </LinearLayout>


        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#12FFFFFF"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/launcherGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:horizontalSpacing="2dp"
                android:numColumns="7"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="0dp" />

            <LinearLayout
                android:id="@+id/launcherEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/launcher_widget_empty"
                    android:textColor="#99A3B2"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
