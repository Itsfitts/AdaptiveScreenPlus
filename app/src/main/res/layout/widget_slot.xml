<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_slot_frame"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">


                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_slot_cell">


                    <ViewFlipper
                        android:id="@+id/slotRollA"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:animateFirstView="false"
                        android:inAnimation="@anim/slot_roll_in"
                        android:outAnimation="@anim/slot_roll_out">
                        <ImageView
                            android:id="@+id/slotA0"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotA1"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotA2"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotA3"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotA4"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotA5"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotA6"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotA7"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                    </ViewFlipper>


                    <TextView
                        android:id="@+id/slotBtnA"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_slot_btn"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/widget_slot_idle"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />


                    <ImageView
                        android:id="@+id/slotResA"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />


                    <ImageView
                        android:id="@+id/slotGlowA"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_slot_cell_win"
                        android:contentDescription="@null"
                        android:visibility="gone" />
                </FrameLayout>


                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_slot_cell">

                    <ViewFlipper
                        android:id="@+id/slotRollB"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:animateFirstView="false"
                        android:inAnimation="@anim/slot_roll_in"
                        android:outAnimation="@anim/slot_roll_out">
                        <ImageView
                            android:id="@+id/slotB0"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotB1"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotB2"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotB3"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotB4"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotB5"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotB6"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotB7"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                    </ViewFlipper>

                    <TextView
                        android:id="@+id/slotBtnB"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_slot_btn"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/widget_slot_idle"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/slotResB"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/slotGlowB"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_slot_cell_win"
                        android:contentDescription="@null"
                        android:visibility="gone" />
                </FrameLayout>


                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_slot_cell">

                    <ViewFlipper
                        android:id="@+id/slotRollC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:animateFirstView="false"
                        android:inAnimation="@anim/slot_roll_in"
                        android:outAnimation="@anim/slot_roll_out">
                        <ImageView
                            android:id="@+id/slotC0"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotC1"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotC2"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotC3"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotC4"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotC5"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotC6"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/slotC7"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                    </ViewFlipper>

                    <TextView
                        android:id="@+id/slotBtnC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_slot_btn"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/widget_slot_idle"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/slotResC"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/slotGlowC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_slot_cell_win"
                        android:contentDescription="@null"
                        android:visibility="gone" />
                </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/slotFoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/widget_slot_ready"
                    android:textColor="#99FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/slotScoreBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_slot_led_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/slotLedH"
                    android:layout_width="9dp"
                    android:layout_height="15.5dp"
                    android:contentDescription="@string/widget_slot_score"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_slot_led_blank" />

                <ImageView
                    android:id="@+id/slotLedT"
                    android:layout_width="9dp"
                    android:layout_height="15.5dp"
                    android:contentDescription="@string/widget_slot_score"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_slot_led_blank" />

                <ImageView
                    android:id="@+id/slotLedO"
                    android:layout_width="9dp"
                    android:layout_height="15.5dp"
                    android:contentDescription="@string/widget_slot_score"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_slot_led_0" />
            </LinearLayout>

            <ImageView
                android:id="@+id/slotLever"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/widget_slot_lever"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_slot_lever" />
        </LinearLayout>
    </LinearLayout>


    <ViewFlipper
        android:id="@+id/slotWinFlip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="54dp"
        android:animateFirstView="false"
        android:inAnimation="@anim/slot_win_in"
        android:outAnimation="@anim/slot_win_out">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <ImageView
            android:id="@+id/slotWinArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_slot_win"
            android:scaleType="fitEnd" />
    </ViewFlipper>
</FrameLayout>
