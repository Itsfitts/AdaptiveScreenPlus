<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootCast"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">


    <LinearLayout
        android:id="@+id/rowCastTop"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCastTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ext_cast_title"
            android:textColor="#E6EAF2"
            android:textSize="14sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/iCastTop"
            style="@style/BetaInfoIcon"
            android:contentDescription="@string/ext_cast_title" />


        <Button
            android:id="@+id/btnCastFull"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/cast_full"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCastToggle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/cast_start"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCastClose"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/ext_close"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/rowCastOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbCastResize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#5AA9E6"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/cast_opt_resize"
            android:textColor="#B9C4D4"
            android:textSize="10sp" />

        <CheckBox
            android:id="@+id/cbCastZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:buttonTint="#5AA9E6"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/cast_opt_zoom"
            android:textColor="#B9C4D4"
            android:textSize="10sp" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/rowCastMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/mirrorBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#05070A">


            <TextureView
                android:id="@+id/mirrorView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center" />


            <TextView
                android:id="@+id/tvCastIdle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/cast_idle"
                android:textColor="#6C7889"
                android:textSize="11sp" />


            <Button
                android:id="@+id/btnCastExitFull"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/ext_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/cast_exit_full"
                android:textAllCaps="false"
                android:textColor="#E6EAF2"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/colCastOps"
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnCastBack"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/ext_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/ext_back"
                android:textAllCaps="false"
                android:textColor="#E6EAF2"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCastHome"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ext_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/ext_home"
                android:textAllCaps="false"
                android:textColor="#E6EAF2"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCastRecent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ext_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/cast_recent"
                android:textAllCaps="false"
                android:textColor="#E6EAF2"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />


            <TextView
                android:id="@+id/tvCastPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:textColor="#6C7889"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/tvCastState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/cast_state_idle"
        android:textColor="#6C7889"
        android:textSize="10sp" />
</LinearLayout>
