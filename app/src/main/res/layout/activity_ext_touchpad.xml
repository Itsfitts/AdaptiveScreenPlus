<?xml version="1.0" encoding="utf-8"?>
<!--
  （） —— 。

  ⚠ ：748×720px / d=1.5 ⇒  498×414dp，
     66px  33px， 482×414dp。
    Top Bar/ 34/40dp，。
    （ RULES §31.1； Activity  density  1.5， 2.125 。）-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Top Bar：Title +  + 。
         、 match_parent（RULES §16.4）， minWidth=0。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ext_pad_title"
            android:textColor="#E6EAF2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ⓘ： /  /  ， -->
        <TextView
            android:id="@+id/iPadTop"
            style="@style/BetaInfoIcon"
            android:contentDescription="@string/ext_pad_title" />

        <Button
            android:id="@+id/btnPadSens"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/ext_sens"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPadClose"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/ext_close"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ：， ——
         ，（ CursorOverlay）。 -->
    <com.wb.extrotator.TouchpadView
        android:id="@+id/padView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1" />

    <!-- ：""， -->
    <!-- ：「」，。
         v3.7 「◀  /  ▶」—— ，
         （）。， 13sp → 12sp、 5dp → 4dp。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPadClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_click"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadHold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_hold"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadPrevPage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1.15"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_page_prev"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadNextPage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1.15"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_page_next"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_back"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_home"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPadHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/ext_pad_hint"
        android:textColor="#6C7889"
        android:textSize="10sp" />
</LinearLayout>
