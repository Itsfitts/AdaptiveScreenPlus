<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="2dp"
    android:paddingTop="3dp"
    android:paddingRight="2dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/pickBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pickIconBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/pickIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/pickCheck"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:contentDescription="@string/launcher_picked"
                android:src="@drawable/ic_pick_check"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pickFav"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="top|start"
                android:contentDescription="@string/launcher_fav"
                android:src="@drawable/ic_pick_star"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/pickLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFEDEDF0"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
