<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pickRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="6dp"
    android:paddingRight="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnPickFav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/launcher_tool_btn"
            android:contentDescription="@string/launcher_fav"
            android:padding="7dp"
            android:src="@drawable/ic_launcher_star" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/launcher_title"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!--
          Title「ⓘ」：（ /  /  / ）。
           InfoIcon （）。
          ⚠ id  i ：" ⓘ"。
        -->
        <TextView
            android:id="@+id/iPickTitle"
            style="@style/BetaInfoIcon" />

        <TextView
            android:id="@+id/tvPickCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#7ED9A0"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/btnPickLook"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/launcher_tool_btn"
            android:contentDescription="@string/launcher_look"
            android:padding="7dp"
            android:src="@drawable/ic_launcher_tune" />

        <ImageView
            android:id="@+id/btnPickSort"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/launcher_tool_btn"
            android:contentDescription="@string/launcher_sort"
            android:padding="7dp"
            android:src="@drawable/ic_launcher_sort" />

        <ImageView
            android:id="@+id/btnPickPhoto"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/launcher_tool_btn"
            android:contentDescription="@string/launcher_photo"
            android:padding="7dp"
            android:src="@drawable/ic_launcher_photo" />

        <ImageView
            android:id="@+id/btnPickClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/launcher_tool_btn"
            android:contentDescription="@string/launcher_close"
            android:padding="9dp"
            android:src="@drawable/ic_launcher_close" />
    </LinearLayout>

    <!-- （、） -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#12FFFFFF"
        android:contentDescription="@null" />

    <EditText
        android:id="@+id/etPickSearch"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/launcher_search_bg"
        android:hint="@string/launcher_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#80FFFFFF"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/gridHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1">

        <!--
          ⚠ listSelector ：GridView  selector
             "" ——  0 ，
             （，
             ""，）。v2.19.0 。
        -->
        <com.wb.extrotator.DragGrid
            android:id="@+id/gvPick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="2dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="4"
            android:scrollbars="vertical"
            android:stretchMode="columnWidth"
            android:verticalSpacing="0dp" />
    </FrameLayout>

    <!--
      （v2.19.0 ，）。

      ：" / "，
       —— ，。
      ，，，。

       gone；Top Bar「」，。
      ： /  ｜  /  ｜  /
      （ v2.19.1 ；，
        ）。
      ⚠ ， CoverLauncherActivity.ChipRow
        （""）。
    -->
    <LinearLayout
        android:id="@+id/lookStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:background="#12FFFFFF"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_look_cols"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/lookCols"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_look_icon"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/lookIcon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_look_gap"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/lookGap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_look_label"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/lookLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <!--
          （v2.19.1 ）： ｜ 。
          （、、），

          ⚠  2  3 ， 31dp ——
             RULES §31.1 （ 339dp ），；
            ，。
          ⚠ 「」，、 ——
            ：，。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_look_shape"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/lookShape"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_look_alpha"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/lookAlpha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPickHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#6C7889"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnPickImport"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/launcher_chip_off"
            android:gravity="center"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/launcher_import"
            android:textColor="#E8EDF5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPickClear"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/launcher_chip_off"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/launcher_clear"
            android:textColor="#E8EDF5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPickDone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/launcher_chip_on"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/launcher_done"
            android:textColor="#FF34C759"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
