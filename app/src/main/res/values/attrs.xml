<?xml version="1.0" encoding="utf-8"?>
<!--
  Samsung proprietary widget attributes for cover screen / Flex Window.

   attr **，**： AOD
  appwidget-provider XML ， getAttributeName() ****
  （ com.samsung.android.app.aodservice  aod.YP.<init>
   widgetStyle / widgetSize / monotoneWidgetSize / lockWidgetSize / previewSize …）。
  allowing third-party widgets to be recognized by cover screen.
  「」(com.tianweixing.atianwidget) 。-->
<resources>

    <!-- ：1=1×1   2=2×1   4=1×2   8=2×2   16=4×2 -->
    <attr name="widgetSize" format="integer" />

    <!-- 1=Card/Panel   2=Icon   3=Progress -->
    <attr name="widgetStyle" format="integer" />

</resources>
