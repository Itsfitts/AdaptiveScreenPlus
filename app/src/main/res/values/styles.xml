<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppPromptDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>


    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="InfoIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:background">@drawable/info_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:text">ⓘ</item>
        <item name="android:textColor">#FF6B7280</item>
        <item name="android:textSize">17sp</item>
    </style>


    <style name="BetaInfoIcon" parent="@style/InfoIcon">
        <item name="android:textColor">#8CFFFFFF</item>
    </style>


    <style name="TabItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/tab_bg</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textSize">13sp</item>
    </style>


    <style name="BetaTabItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/beta_tab_bg</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColor">@color/beta_tab_text</item>
        <item name="android:textSize">13sp</item>
    </style>


    <style name="BetaSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFF0F0F0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="BetaText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8CFFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>


    <style name="BetaInput">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/beta_input</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColor">#FFF0F0F0</item>
        <item name="android:textColorHint">#59FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>


    <style name="BetaButtonPrimary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/beta_btn_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>


    <style name="BetaButtonGhost">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/beta_btn_ghost</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>


    <style name="BetaChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/beta_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>


    <style name="BetaSwitch">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:textColor">#FFF0F0F0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:thumbTint">@color/beta_switch_thumb</item>
        <item name="android:trackTint">@color/beta_switch_track</item>
    </style>

    <style name="PseudoToggle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/pseudo_toggle_bg</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">#FFBBBBBB</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
